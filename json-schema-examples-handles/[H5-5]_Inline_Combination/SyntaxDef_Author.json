{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "@id": "hdl:21.T11969/example_author_syntax",
  "title": "Author_Syntax",
  "description": "Validates any author who has at least a last name and potentially a first name.",
  "type": "object",
  "properties": {
    "first_name": {
      "@id": "hdl:21.T11969/example_name_syntax",
      "type": "string",
      "pattern": "^[a-zA-Z0-9\\s]+$",
      "minLength": 1
    },
    "last_name": {
      "$ref": "https://raw.githubusercontent.com/fairdo-org/handle_fdo_specification/refs/heads/jana-json-schemas/json-schema-examples-handles/%5BH4-4%5D_Syntax/SyntaxDef_Name.json"
    }
  },
  "required": [
    "last_name"
  ],
  "additionalProperties": false
}