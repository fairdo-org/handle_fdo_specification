{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handle wrapper",
  "description": "This schema wraps any kind of syntax definition into a handle-record compliant validation schema.",
  "type": "object",
  "properties": {
    "responseCode": {
      "type": "number"
    },
    "handle": {
      "type": "string"
    },
    "values": {
      "type": "array",
      "items": {
        "title": "FDO Record Item",
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "data": {
            "type": "object",
            "properties": {
              "value": {}
            },
            "patternProperties": {
              "^format$": {
                "type": "string"
              }
            },
            "required": [
              "format",
              "value"
            ]
          },
          "ttl": {
            "type": "number"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "patternProperties": {
          "^type$": {
            "$anchor": "type",
            "type": "string"
          }
        },
        "required": [
          "index",
          "type",
          "data",
          "ttl",
          "timestamp"
        ]
      }
    }
  },
  "required": [
    "responseCode",
    "handle",
    "values"
  ],
  "additionalProperties": false
}